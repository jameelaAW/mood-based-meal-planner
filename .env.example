# Supabase — get from your project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — used by /api routes to write mood_checkins / shopping_lists.
# RLS is permissive in v1 (see docs/DATA_MODEL.md), so the anon key above is
# sufficient; this is only needed once the "lock it down" sprint changes RLS.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — powers interpret_mood / generate_why_it_fits (docs/AGENTIC_LAYER.md).
# If unset, the app falls back to rule-based why-it-fits copy — it never crashes.
OPENAI_API_KEY=

# App URL (used for redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
